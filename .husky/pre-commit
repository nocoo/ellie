#!/bin/bash
# Pre-commit — L1 (and Ellie lanes) against the Git index snapshot.
# Husky runs hooks via "sh -e"; re-exec under bash for parallel stages.
if [ -z "$_ELLIE_HOOK_BASH" ]; then export _ELLIE_HOOK_BASH=1; exec bash "$0" "$@"; fi

# Exports index → temp dir, symlinks installed deps, runs full L1 every commit
# (no extension-based skips). Stages align with package.json gates; L2 stays in
# pre-commit for speed regression coverage — update pre-push when semantics move.

set -o pipefail

command -v git >/dev/null 2>&1 || {
	echo "pre-commit: git is required" >&2
	exit 1
}
command -v bun >/dev/null 2>&1 || {
	echo "pre-commit: bun is required" >&2
	exit 1
}
command -v gitleaks >/dev/null 2>&1 || {
	echo "pre-commit: gitleaks is required" >&2
	exit 1
}

snapshot=
TMPDIR_HOOK=
cleanup() {
	status=$?
	trap - EXIT INT TERM HUP
	if [ -n "$TMPDIR_HOOK" ]; then
		rm -rf "$TMPDIR_HOOK" || :
		TMPDIR_HOOK=
	fi
	if [ -n "$snapshot" ]; then
		rm -rf "$snapshot" || :
		snapshot=
	fi
	exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

# gitleaks reads the commit index — run before stripping Git hook env.
gitleaks protect --staged --no-banner

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/ellie-index-XXXXXX")
git checkout-index --all --prefix="$snapshot/"
repo=$(git rev-parse --show-toplevel)

if [ ! -d "$repo/node_modules" ]; then
	echo "pre-commit: node_modules is required (run bun install)" >&2
	exit 1
fi
if [ ! -f "$snapshot/package.json" ] || [ ! -f "$snapshot/bun.lock" ]; then
	echo "pre-commit: staged package.json and bun.lock are required" >&2
	exit 1
fi
if ! cmp -s "$snapshot/package.json" "$repo/package.json" || ! cmp -s "$snapshot/bun.lock" "$repo/bun.lock"; then
	echo "pre-commit: staged package.json/bun.lock must match the installed worktree copies" >&2
	exit 1
fi

link_node_modules_tree() {
	local dest_root="$1"
	local src_root="$2"
	local nm
	while IFS= read -r nm; do
		[ -n "$nm" ] || continue
		local rel="${nm#"$src_root"/}"
		mkdir -p "$(dirname "$dest_root/$rel")"
		ln -sfn "$nm" "$dest_root/$rel"
	done < <(find "$src_root" -maxdepth 4 -name node_modules -type d ! -path '*/node_modules/*' ! -path '*/.next/*' 2>/dev/null)
}

link_node_modules_tree "$snapshot" "$repo"

mkdir -p "$snapshot/.cache"

# Optional local Worker secrets (ignored paths — use worktree copy when present).
if [ -e "$repo/.dev.vars" ]; then
	ln -sfn "$repo/.dev.vars" "$snapshot/.dev.vars"
fi
if [ -e "$repo/apps/worker/.dev.vars" ]; then
	mkdir -p "$snapshot/apps/worker"
	ln -sfn "$repo/apps/worker/.dev.vars" "$snapshot/apps/worker/.dev.vars"
fi

# Next route types: only reuse worktree .next when index matches worktree for that app.
for app in apps/web apps/admin; do
	if [ ! -d "$snapshot/$app/src/app" ]; then
		continue
	fi
	if git diff --quiet -- "$app"; then
		if [ -d "$repo/$app/.next" ]; then
			mkdir -p "$snapshot/$app"
			rm -rf "$snapshot/$app/.next"
			ln -sfn "$repo/$app/.next" "$snapshot/$app/.next"
		fi
	fi
done

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/.cache"
export XDG_STATE_HOME="$snapshot/.cache"
export ELLIE_INDEX_TYPECHECK=1
PATH="$repo/node_modules/.bin:$snapshot/node_modules/.bin:/usr/local/bin:${HOME}/.bun/bin:$PATH"
cd "$snapshot"

TMPDIR_HOOK=$(mktemp -d -t ellie-precommit-XXXXXX)

run_bg() {
	local name="$1"
	shift
	( "$@" >"$TMPDIR_HOOK/$name.log" 2>&1; echo $? >"$TMPDIR_HOOK/$name.exit" ) &
	eval "PID_$name=$!"
}

wait_stage() {
	local name="$1" pid_var="PID_$1" pid status
	pid=${!pid_var}
	wait "$pid" 2>/dev/null || true
	status=$(cat "$TMPDIR_HOOK/$name.exit" 2>/dev/null || echo 1)
	echo "━━━ $name (exit=$status) ━━━"
	cat "$TMPDIR_HOOK/$name.log"
	if [ "$status" -ne 0 ]; then
		echo "❌ pre-commit stage '$name' failed" >&2
		jobs -p | xargs -r kill 2>/dev/null || true
		exit "$status"
	fi
}

# Full L1 every commit — no staged-extension fast paths.
run_bg typecheck bun run typecheck
run_bg lint       bun run lint
run_bg unit       bun run test:coverage
run_bg l2         bun run test:l2
run_bg rust       bash -c 'export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-1.88.0}"; cd packages/cli-rs && cargo fmt --check --all && cargo clippy --all-targets --all-features -- -D warnings && cargo test --workspace'

wait_stage typecheck
wait_stage lint
wait_stage unit
wait_stage l2
wait_stage rust
